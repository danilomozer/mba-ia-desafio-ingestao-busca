# Provedor: "openai" ou "gemini".
# Se ficar vazio, usa o provedor que tiver API key preenchida (OpenAI primeiro).
PROVIDER=

# OpenAI
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_LLM_MODEL=gpt-6-luna

# Gemini
GOOGLE_API_KEY=
GOOGLE_EMBEDDING_MODEL=gemini-embedding-001
GOOGLE_LLM_MODEL=gemini-3.5-flash-lite

# Banco de dados (docker-compose do projeto)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/rag
PG_VECTOR_COLLECTION_NAME=documentos_pdf

# Caminho do PDF (relativo à raiz do projeto ou absoluto)
PDF_PATH=document.pdf
